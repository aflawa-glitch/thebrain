# Copy to portable.env and edit for the exact OS/CPU runtime bundled with this drive.
# Values can be relative to this root or explicit absolute paths.
# The launcher NEVER silently falls back to system Python or a different model.

PYTHON_PATH=runtimes/macos-arm64/bin/python3
LLAMA_SERVER_PATH=runtimes/macos-arm64/bin/llama-server
LLM_MODEL=auto
MODEL_PATH=models/qwen2.5-coder-14b-instruct-q4_k_m.gguf
LLM_HOST=127.0.0.1
LLM_PORT=8081
LLM_MODEL=auto
APP_HOST=127.0.0.1
APP_PORT=8080
CONTEXT_SIZE=4096
GPU_LAYERS=-1
LLM_ENABLED=true
WEB_SEARCH_ENABLED=true
OPEN_BROWSER=true
STARTUP_TIMEOUT_SECONDS=120
DATA_DIR=data
LOG_DIR=logs
