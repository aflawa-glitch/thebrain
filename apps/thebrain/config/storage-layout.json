{
  "schema_version": 2,
  "storage_root_required": true,
  "directories": {
    "apps": "apps", "models": "models",
    "llama_cpp_runtimes": "runtimes/llama.cpp",
    "python_runtimes": "runtimes/python",
    "environments": "environments", "packs": "packs",
    "runtime_state": ".julian-runtime",
    "logs": "logs", "data": "data", "backups": "backups"
  },
  "isolation": {
    "python_runtime_shared_per_platform": true,
    "python_environment_per_application": true,
    "native_binaries_platform_specific": true,
    "models_shared_read_only": true
  },
  "multi_app": {
    "environments_per_app": true, "data_per_app": true,
    "logs_per_app": true, "backups_per_app": true,
    "packs_shared": true, "llama_server": "shared_service"
  },
  "multi_model_policy": "shared_server_swap_on_demand",
  "integrity": { "manifest_algorithm": "sha256", "manifest_location": "external" }
}
