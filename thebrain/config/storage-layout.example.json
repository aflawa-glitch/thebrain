{
  "schema_version": 1,
  "description": "Declarative storage contract. Paths are relative to the chosen storage root unless a local override file specifies an absolute path.",
  "directories": {
    "apps": "apps",
    "models": "models",
    "llama_cpp_runtimes": "runtimes/llama.cpp",
    "python_runtimes": "runtimes/python",
    "shared_runtime_state": ".julian-runtime",
    "logs": "logs/julian",
    "data": "data/julian",
    "backups": "backups/julian"
  },
  "model": {
    "provider": "llama.cpp",
    "api_style": "openai-compatible",
    "default_base_url": "http://127.0.0.1:8081/v1",
    "model_file_extension": ".gguf",
    "model_path_must_be_explicit_when_discovery_is_ambiguous": true
  },
  "isolation": {
    "python_runtime_shared_per_platform": true,
    "python_environment_per_application": true,
    "native_binaries_platform_specific": true
  }
}
